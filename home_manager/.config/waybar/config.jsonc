{
    "layer": "top",
    "position": "top",
    "height": 16,
    "spacing": 1,
    "margin": "0 0 0 0",
    "output": ["DP-1"],
    
    "modules-left": ["hyprland/window"],
    "modules-center": ["hyprland/workspaces"],
    "modules-right": ["idle_inhibitor", "pulseaudio", "cpu", "memory", "clock", "custom/power", "tray"],

    "cpu": {
        "format": "[CPU:{usage}%]",
        "interval": 10
    },

    "memory": {
        "format": "[MEM:{percentage}%]",
        "interval": 30
    },

    "hyprland/workspaces": {
        "disable-scroll": true,
        "on-click": "activate",
        "all-outputs": true,
        "format": "{name}"
    },

    "hyprland/window": {
        "format": "[{title}]",
        "max-length": 500,
        "rewrite": {
            "(.*)Mozilla Firefox": "󰈹 $1",
            "(.*) - Visual Studio Code": "󰘐 $1"
        }
    },

    "idle_inhibitor": {
        "format": "[{icon}]",
        "format-icons": {
            "activated": "AWAKE",
            "deactivated": "ASLEEP"
        }
    },

    "tray": {
        "spacing": 10,
        "icon-size": 16
    },

    "clock": {
        "format": "[{:%H:%M}]",
        "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>",
        "format-alt": "{:%b %d}"
    },

    "pulseaudio": {
        // "scroll-step": 1, // %, can be a float
        "format": "[VOL:{volume}%]",
        "format-muted": "[VOL:{volume}%]",
        "format-bluetooth": "[VOL:{volume}%]",
        "format-bluetooth-muted": "[{icon}]",
        "on-click": "pavucontrol"
    },

    "custom/power": {
        "format": "[POWER]",
        "exec-on-event": true,
        "on-click": "~/.config/wofi-power.mjs",
        "tooltip": false
    }
}

