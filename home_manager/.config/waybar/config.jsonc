{
    "layer": "top",
    "position": "top",
    "height": 40,
    "spacing": 1,
    "margin": "0 0 0 0",

    "modules-left": ["custom/separator", "hyprland/workspaces", "hyprland/mode"],
    "modules-center": ["hyprland/window"],
    "modules-right": ["custom/speaker_toggle", "custom/monitor_selector", "idle_inhibitor", "backlight", "tray", "pulseaudio", "battery", "clock", "custom/power"],

    "custom/separator": {
        "format": "​",
        "tooltip": false
    },

    "custom/monitor_selector": {
        "format": "{icon}",
        "format-icons": "󰍹 ",
        "exec-on-event": true,
        "on-click": "~/.config/monitor-selector.mjs",
        "tooltip": false
    },

    "custom/speaker_toggle": {
        "format": "{icon}",
        "return-type": "json",
        "exec": "cat ~/.config/speaker_state",
        "interval": 1,
        "on-click": "bash ~/.config/toggle_speakers.sh",
        "format-icons": {
            "on": "󰓃", 
            "off": "󰓄"
        }
    },

    "hyprland/workspaces": {
        "disable-scroll": true,
        "on-click": "activate",
        "all-outputs": true,
        "format": "{name}"
    },
    "hyprland/mode": {
        "format": "<span style=\"italic\">{}</span>"
    },
    "hyprland/window": {
        "format": "{title}",
        "max-length": 50,
        "rewrite": {
            "filip@endeavour(.*)": " $1",
            "(.*)Mozilla Firefox": "󰈹 $1",
            "(.*) - Visual Studio Code": "󰘐 $1"
        }
    },
    "idle_inhibitor": {
        "format": "{icon}",
        "format-icons": {
            "activated": "",
            "deactivated": ""
        }
    },
    "tray": {
        "spacing": 10
    },

    "clock": {
        "format": "󰥔 {:%H:%M}",
        "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>",
        "format-alt": "{:%b %d}"
    },

    "pulseaudio": {
        // "scroll-step": 1, // %, can be a float
        "format": "{volume}% {icon}",
        "format-muted": "{volume}% ",
        "format-bluetooth": "{volume}% {icon}",
        "format-bluetooth-muted": " {icon}",
        "format-icons": {
            "default": ["", "", ""]
        },
        "on-click": "pavucontrol"
    },

    "custom/power": {
        "format": "{icon}",
        "format-icons": "󰕰 ",
        "exec-on-event": true,
        "on-click": "~/.config/wofi-power.mjs",
        "tooltip": false
    }
}

